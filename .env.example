# Active settings (read by the application today)
DATABASE_URL=postgresql+psycopg://routemuse:routemuse@localhost:5432/routemuse
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Public URL of a production-appropriate MapLibre style JSON. No fallback tiles are bundled.
NEXT_PUBLIC_MAP_STYLE_URL=
# Register this exact callback URL in the Strava API application settings.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/v1/strava/callback
# Generate and retain a stable Fernet key; changing it invalidates stored tokens.
STRAVA_TOKEN_ENCRYPTION_KEY=
# Server-side only. Create a key at https://openrouteservice.org/dev/#/signup.
OPENROUTESERVICE_API_KEY=
# Optional OpenStreetMap discovery endpoint and honest HTTP identification.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT=RouteMuse/0.1 (OpenStreetMap discovery)

# Optional server-side Ollama provider (must already be running with the model installed)
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_REQUEST_TIMEOUT_SECONDS=30
